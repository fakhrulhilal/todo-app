{
  "components": {
    "schemas": {
      "CreateTodo": {
        "properties": {
          "title": {
            "description": "1 to 200 characters after trimming.",
            "example": "Buy milk",
            "type": "string"
          }
        },
        "required": [
          "title"
        ],
        "type": "object"
      },
      "HealthCheckResult": {
        "description": "What one check found.",
        "properties": {
          "data": {
            "description": "Extra values worth showing, such as a queue length.",
            "type": "object"
          },
          "description": {
            "description": "Safe to show to whoever can call the probe: no connection strings,\nhost names or raw error messages.",
            "example": "The database answered.",
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          }
        },
        "required": [
          "status",
          "data"
        ],
        "type": "object"
      },
      "HealthReport": {
        "description": "The outcome of a probe.",
        "properties": {
          "results": {
            "additionalProperties": {
              "$ref": "#/components/schemas/HealthCheckResult"
            },
            "description": "One entry per check, by name.",
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "status": {
            "$ref": "#/components/schemas/HealthStatus",
            "description": "The worst status among the checks; `Healthy` when there are none."
          }
        },
        "required": [
          "status",
          "results"
        ],
        "type": "object"
      },
      "HealthStatus": {
        "description": "Ordered from worst to best, so the status of a report is the minimum of\nits checks.",
        "enum": [
          "Unhealthy",
          "Degraded",
          "Healthy"
        ],
        "type": "string"
      },
      "Problem": {
        "description": "An RFC 9457 problem details object.",
        "properties": {
          "detail": {
            "description": "Explanation specific to this occurrence.",
            "type": [
              "string",
              "null"
            ]
          },
          "errors": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "description": "The members of the request that failed validation: what is wrong\nwith each, by name.",
            "example": {
              "title": [
                "must not be empty"
              ]
            },
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "instance": {
            "description": "URI reference identifying this occurrence: the path that was requested.",
            "example": "/api/v1/todos/01981f3e-7d55-7c42-9b0a-3b1f6c2f4a10",
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "description": "The HTTP status code.",
            "example": 404,
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "title": {
            "description": "Short summary of the problem type.",
            "example": "Not Found",
            "type": "string"
          },
          "type": {
            "description": "URI reference identifying the problem type.",
            "example": "about:blank",
            "type": "string"
          }
        },
        "required": [
          "title",
          "status"
        ],
        "type": "object"
      },
      "Todo": {
        "properties": {
          "completed": {
            "type": "boolean"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "title": {
            "example": "Buy milk",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "completed",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      },
      "UpdateTodo": {
        "description": "Fields left out keep their current value.",
        "properties": {
          "completed": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "title": {
            "example": "Buy oat milk",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      }
    }
  },
  "info": {
    "description": "A todo list. Errors are RFC 9457 problem details.",
    "license": {
      "name": ""
    },
    "title": "Todo API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/todos": {
      "get": {
        "description": "Returns todos oldest first.",
        "operationId": "list_todos",
        "parameters": [
          {
            "description": "Which todos to return.",
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/StatusFilter"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Todo"
                  },
                  "type": "array"
                }
              }
            },
            "description": "The matching todos"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Invalid query"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unexpected failure"
          }
        },
        "summary": "List todos",
        "tags": [
          "todos"
        ]
      },
      "post": {
        "operationId": "create_todo",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTodo"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Todo"
                }
              }
            },
            "description": "The created todo"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Malformed request"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Validation failed"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unexpected failure"
          }
        },
        "summary": "Create a todo",
        "tags": [
          "todos"
        ]
      }
    },
    "/api/v1/todos/{id}": {
      "delete": {
        "operationId": "delete_todo",
        "parameters": [
          {
            "description": "Todo id",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Invalid id"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No such todo"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unexpected failure"
          }
        },
        "summary": "Delete a todo",
        "tags": [
          "todos"
        ]
      },
      "get": {
        "operationId": "get_todo",
        "parameters": [
          {
            "description": "Todo id",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Todo"
                }
              }
            },
            "description": "The todo"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Invalid id"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No such todo"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unexpected failure"
          }
        },
        "summary": "Get a todo",
        "tags": [
          "todos"
        ]
      },
      "patch": {
        "description": "Changes the title, the completed flag, or both.",
        "operationId": "update_todo",
        "parameters": [
          {
            "description": "Todo id",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateTodo"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Todo"
                }
              }
            },
            "description": "The updated todo"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Malformed request"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No such todo"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Validation failed"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unexpected failure"
          }
        },
        "summary": "Update a todo",
        "tags": [
          "todos"
        ]
      }
    },
    "/health/live": {
      "get": {
        "description": "Healthy for as long as the server answers requests. Runs no checks.",
        "operationId": "live",
        "parameters": [
          {
            "description": "`json` for the result of each check. The status alone otherwise.",
            "in": "query",
            "name": "format",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/HealthFormat"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReport"
                }
              },
              "text/plain": {
                "example": "Healthy",
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "The process is running"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Invalid query"
          }
        },
        "summary": "Liveness probe",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "description": "Runs every registered check and reports the worst status: `Healthy`,\n`Degraded` (still 200) or `Unhealthy` (503).",
        "operationId": "ready",
        "parameters": [
          {
            "description": "`json` for the result of each check. The status alone otherwise.",
            "in": "query",
            "name": "format",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/HealthFormat"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReport"
                }
              },
              "text/plain": {
                "example": "Healthy",
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Ready to serve requests: Healthy or Degraded"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Invalid query"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReport"
                }
              },
              "text/plain": {
                "example": "Unhealthy",
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "A check is Unhealthy"
          }
        },
        "summary": "Readiness probe",
        "tags": [
          "health"
        ]
      }
    }
  },
  "tags": [
    {
      "description": "Manage todos",
      "name": "todos"
    },
    {
      "description": "Liveness and readiness probes",
      "name": "health"
    }
  ]
}
